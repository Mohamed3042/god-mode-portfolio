---
import '../styles/global.css';
import GmSwitcher from '../components/GmSwitcher.astro';
import { THEMES, type ThemeId } from '../lib/themes';
import { withBase } from '../lib/base';
import { profile } from '../data/profile';

interface Props {
  theme: ThemeId;
  title: string;
  description?: string;
}
const { theme, title, description } = Astro.props;
const meta = THEMES[theme];
const desc =
  description ??
  `${profile.identity.name} — ${profile.identity.tagline} ${profile.heroLine}. One portfolio, seven distinct worlds.`;
const publicSite = Astro.site ?? new URL('https://mohamed3042.github.io');
const canonicalUrl = new URL(Astro.url.pathname, publicSite).href;
const ogImageUrl = new URL(withBase(`/og/${theme}.svg`), publicSite).href;

// The hub previews all seven identities in their own fonts, so load those display faces too.
const HUB_PREVIEW_FONTS =
  'https://fonts.googleapis.com/css2?family=Anton&family=Chakra+Petch:wght@700&family=Cinzel:wght@800&family=Montserrat:wght@800&family=Saira+Stencil+One&family=Sora:wght@700;800&display=swap';
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content={meta.accent} />
    <meta name="author" content={profile.identity.name} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {meta.fontsHref && (
      <>
        <link rel="preload" href={meta.fontsHref} as="style" />
        <link rel="stylesheet" href={meta.fontsHref} media="print" data-font-stylesheet />
        <noscript><link rel="stylesheet" href={meta.fontsHref} /></noscript>
      </>
    )}
    {theme === 'hub' && (
      <>
        <link rel="preload" href={HUB_PREVIEW_FONTS} as="style" />
        <link rel="stylesheet" href={HUB_PREVIEW_FONTS} media="print" data-font-stylesheet />
        <noscript><link rel="stylesheet" href={HUB_PREVIEW_FONTS} /></noscript>
      </>
    )}
    <script is:inline>
      for (const link of document.querySelectorAll('link[data-font-stylesheet]')) {
        const activate = () => link.setAttribute('media', 'all');
        if (link.sheet) activate();
        else link.addEventListener('load', activate, { once: true });
      }
    </script>

  </head>
  <body data-theme={theme}>
    <GmSwitcher active={theme} />

    <slot />
  </body>
</html>
